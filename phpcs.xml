<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Webshore WordPress Composer Package Standard">
	<description>
		Custom PHPCS standard for modern Composer-based WordPress packages.
		Uses WordPress Coding Standards for WordPress-facing APIs, security,
		escaping, sanitization, i18n, database access, and hooks.
		Uses modern PHP/Composer conventions for namespaced PSR-4 source code and
		relaxes WordPress naming rules for files, classes, methods, and variables.
	</description>

	<!-- Scan project PHP files by default. -->
	<file>.</file>
	<exclude-pattern>.raw/*</exclude-pattern>
	<exclude-pattern>tests/bootstrap.php</exclude-pattern>

	<!-- CLI behavior. -->
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<!-- Exclusions. -->
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/coverage/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<!-- Runtime targets. -->
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.3"/>

	<!-- PHP compatibility for WordPress-context projects. -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- Generic quality checks. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	<rule ref="Generic.Commenting.Todo"/>
	<rule ref="Generic.Commenting.DocComment.MissingShort"/>
	<rule ref="Squiz.WhiteSpace.SuperfluousWhitespace"/>

	<!-- WordPress standards, adapted for modern Composer/PSR-4 package code. -->
	<rule ref="WordPress-Extra">
		<!-- Composer/PSR-4 package layout. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedNamespaceFound"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedClassFound"/>

		<!-- Modern OOP naming instead of strict WordPress snake_case variables/functions. -->
		<exclude name="WordPress.NamingConventions.ValidFunctionName"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>

		<!-- Modern PHP syntax. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>

		<!-- Project style: normal condition order instead of Yoda conditions. -->
		<exclude name="WordPress.PHP.YodaConditions"/>

		<!-- Project style: spaces instead of WordPress-style tabs. -->
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
		<exclude name="Universal.WhiteSpace.PrecisionAlignment"/>

		<!-- Avoid noisy false positives during refactors. -->
		<exclude name="Squiz.PHP.CommentedOutCode.Found"/>
	</rule>

	<!-- Documentation rules: relaxed, but still enforce useful docblock quality when docs exist. -->
	<rule ref="WordPress-Docs">
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
	</rule>

	<!-- I18n: project-specific text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="string" value="wp-update-sdk"/>
		</properties>
	</rule>

	<!-- Enforce 4-space indentation instead of WordPress Core tab indentation. -->
	<rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
	<rule ref="Generic.WhiteSpace.ScopeIndent">
		<properties>
			<property name="indent" value="4"/>
			<property name="tabIndent" value="false"/>
		</properties>
	</rule>

	<!-- Allow . and / in hook names, e.g. openblocks/query/args. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="./"/>
		</properties>
	</rule>

	<!-- Enforce prefixes for WordPress-facing globals and identifiers. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="webshore"/>
				<element value="wp_update_sdk"/>
				<element value="wpus"/>
			</property>
		</properties>
	</rule>
</ruleset>
